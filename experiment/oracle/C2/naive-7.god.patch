+    /**
+     * 제한이 새로 걸리거나 갱신될 때(판매 제한 = 판매자 귀책, 구매 제한 = payment-due) 그 사용자의 그 쪽 ACTIVE 입찰을 모두 취소한다.
+     * 유효기간이 지났지만 아직 bid-expiry가 처리하지 않은 ACTIVE 입찰도 대상이다. 입찰마다 그 사이즈를 잠그고(§3.3) 다시 읽은 뒤
+     * ACTIVE인 것만 ACTIVE → CANCELLED(이벤트 trade_id NULL). 호출자의 트랜잭션 안에서 부른다.
+     */
+    private fun cancelActiveBids(userId: Long, side: String, now: Instant) {
+        val active = em.createQuery(
+            "SELECT b FROM Bid b WHERE b.userId = :user AND b.side = :side AND b.status = 'ACTIVE' ORDER BY b.productSizeId, b.id",
+            Bid::class.java,
+        ).setParameter("user", userId).setParameter("side", side).resultList
+        for (bid in active) {
+            lockProductSize(bid.productSizeId)
+            em.refresh(bid)
+            if (bid.status != "ACTIVE") continue
+            bid.status = "CANCELLED"
+            em.persist(BidEvent(bidId = bid.id!!, fromStatus = "ACTIVE", toStatus = "CANCELLED", tradeId = null, createdAt = now))
+        }
+    }
