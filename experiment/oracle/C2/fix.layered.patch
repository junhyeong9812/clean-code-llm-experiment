+package com.ccle.layered.service
+
+import com.ccle.layered.domain.SellerPenalty
+import com.ccle.layered.domain.SellerPenaltyRepository
+import org.springframework.stereotype.Service
+
+/** `GET /me/penalties`: 판매자 본인 패널티, created_at 내림차순(같으면 id 내림차순). 사용자 확인은 부르는 쪽이 한다. */
+@Service
+class PenaltyQueryService(private val penalties: SellerPenaltyRepository) {
+
+    fun list(sellerId: Long): List<SellerPenalty> = penalties.listOf(sellerId)
+}
