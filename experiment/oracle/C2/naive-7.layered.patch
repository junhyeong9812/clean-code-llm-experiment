+ * 유효기간이 지났지만 아직 bid-expiry가 처리하지 않은 ACTIVE 입찰도 대상이다. 입찰마다 그 사이즈를 잠그고(§3.3) 다시 읽은 뒤
+ * ACTIVE인 것만 ACTIVE → CANCELLED(이벤트 trade_id NULL). 호출자의 트랜잭션 안에서 부른다.
+ */
+@Component
+class RestrictedBidCanceller(
+    private val sizes: ProductSizeRepository,
+    private val bids: BidRepository,
+    private val events: BidEventRepository,
+) {
+    fun cancelActive(userId: Long, side: String, now: Instant) {
+        for (bid in bids.activeOf(userId, side)) {
+            sizes.lock(bid.productSizeId)
+            bids.reload(bid)
+            if (bid.status == "ACTIVE") events.add(bid.cancel(now))
+        }
+    }
+}
